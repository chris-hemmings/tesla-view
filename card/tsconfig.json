{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "strict": false, "noImplicitAny": false, "experimentalDecorators": true, "useDefineForClassFields": false,
    "skipLibCheck": true, "isolatedModules": true, "resolveJsonModule": true, "types": []
  },
  "include": ["src", "dev"]
}
